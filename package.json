{
  "name": "synctask",
  "version": "1.0.0",
  "description": "SyncTask - Cross-device To-Do List with Realtime Sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "package": "electron-packager . SyncTask --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --prune=true",
    "package:zip": "npm run package && powershell Compress-Archive -Path dist/SyncTask-win32-x64/* -DestinationPath dist/SyncTask-Windows-x64.zip -Force",
    "package:builder": "electron-builder --win --x64",
    "package:dir": "electron-builder --dir"
  },
  "keywords": [
    "todo",
    "productivity",
    "sync",
    "cross-platform",
    "pwa",
    "electron"
  ],
  "author": "Tiago van Bennekom",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^24.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.synctask.app",
    "productName": "SyncTask",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "sw.js",
      "manifest.json",
      "css/**/*",
      "js/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "ws": "^8.21.3"
  }
}
